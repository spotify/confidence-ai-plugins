{
  "mcpServers": {
    "confidence-flags": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT:-.}/scripts/confidence-mcp-proxy.mjs",
        "flags"
      ]
    },
    "confidence-docs": {
      "type": "http",
      "url": "https://mcp.confidence.dev/mcp/docs",
      "headers": {
        "x-confidence-mcp-consumer": "plugin"
      }
    }
  }
}
